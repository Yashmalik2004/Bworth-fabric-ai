# Datasets are local or externally sourced assets
datasets/*
# Phase 4 verified-dataset docs and CSV templates are tracked; collected data is not
!datasets/phase4_verified/
datasets/phase4_verified/images/
datasets/phase4_verified/metadata/verification_documents/
datasets/phase4_verified/metadata/manifests/
# registry migration backups and logs stay local (copies of registries; never committed)
datasets/phase4_verified/metadata/migration_backups/
datasets/phase4_verified/metadata/migration_log.jsonl
data/

# Model checkpoints and machine learning artifacts
models/**/*.pth
models/**/*.pt
models/**/*.ckpt
models/**/*.safetensors
models/**/*.onnx
checkpoints/
runs/
evaluation/composition/diagnostics/sheets/

# OS metadata
.DS_Store
Thumbs.db
# Phase 3 experiments: regenerable arrays and bulk dataset-thumbnail review sheets
experiments/**/*.npy
experiments/**/*.pth
experiments/phase3_global_fabric_audit/audit/contact_sheets/review_families/
experiments/phase3_global_fabric_audit/audit/contact_sheets/review_pages/
experiments/phase3_global_fabric_audit/audit/contact_sheets/review_cross_family_pairs.jpg
experiments/phase3_recovered_data/audit/review_sheet_*.jpg
# ...but keep the Stage A corrected-dataset manifests (CSV/MD only; raw images stay ignored via datasets/)
!experiments/phase3_global_fabric_audit/datasets/
# dataset-thumbnail contact sheets are not committed (dataset licence for derivatives unconfirmed)
experiments/**/contact_sheets/
experiments/phase3_recovered_data/audit/*.jpg
# NIST E1: large regenerable per-image embedding tables (swatch-level CSVs, plots and report stay trackable)
experiments/nist_nir_sort/e1_visual_feature_analysis/*_image_embeddings.csv

# Local experiment backups (contain model checkpoints; never commit to ordinary GitHub)
backups/
